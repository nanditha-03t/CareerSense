# Server Configuration
PORT=5001
NODE_ENV=development

# MongoDB Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/jobfit

# Authentication (JWT)
JWT_SECRET=your_jwt_super_secret_signing_key_here
JWT_EXPIRES_IN=1d

# Optional External Job Feeds
# Remotive public tech job feed is integrated without requiring an API key.
# Optional provider credentials:
# ADZUNA_APP_ID=
# ADZUNA_API_KEY=
